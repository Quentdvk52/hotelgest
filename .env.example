# ==============================================================================
# HotelGest Environment Configuration
# ==============================================================================

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-host.region.aws.neon.tech/neondb?sslmode=require"

# Object Storage (S3-compatible / Neon Storage)
AWS_ENDPOINT_URL_S3="https://storage.region.aws.neon.tech"
AWS_ACCESS_KEY_ID="nak_live_xxx"
AWS_SECRET_ACCESS_KEY="nsk_live_xxx"
AWS_REGION="us-east-2"
S3_BUCKET_NAME="hotelgest-assets"

# Chariow SaaS Billing Integration
CHARIOW_API_KEY="chariow_test_xxx"
CHARIOW_WEBHOOK_SECRET="chariow_webhook_secret_xxx"
CHARIOW_PLAN_MONTHLY_XOF="100000"
CHARIOW_PLAN_SEMIANNUAL_XOF="540000"
CHARIOW_PLAN_ANNUAL_XOF="840000"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_CURRENCY="XOF"
NEXT_PUBLIC_DEFAULT_LOCALE="fr"
JWT_SECRET="super-secret-jwt-token-hotelgest-minimum-32-chars-long"
